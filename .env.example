# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=powerops-v1
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Embeddings (configurable provider)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Chat LLM (configurable provider)
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# OpenAI (used for embeddings and/or chat depending on providers above)
OPENAI_API_KEY=

# Retrieval
TOP_K=5
